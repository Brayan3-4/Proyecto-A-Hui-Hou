generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
url = "mysql://root:@localhost:3306/tienda"
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  precio      Float
}
model Usuario {
  id      Int    @id @default(autoincrement())
  nombre  String
  correo  String
}
